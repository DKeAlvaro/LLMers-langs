  "grammar": [
    {
      "title": "Dutch sounds: spelling and pronunciation",
      "explanation": "Dutch spelling is quite regular: long vowels are written double (**aa**, **ee**, **oo**, **uu**), short vowels single. The combinations **ui**, **ij/ei**, **oe**, **eu** and **g/ch** are new for most English speakers. Listen and repeat the example words; for now you only need the sounds, not the words.",
      "table": {
        "headers": [
          "Spelling",
          "Sounds like",
          "Example"
        ],
        "rows": [
          [
            "ui",
            "No English equivalent: say 'ay' as in 'say' and round your lips",
            "huis (house)"
          ],
          [
            "ij / ei",
            "Like 'ay' in 'say', but shorter",
            "mijn (my), klein (small)"
          ],
          [
            "oe",
            "Like 'oo' in 'boot', but shorter",
            "goed (good), boek (book)"
          ],
          [
            "eu",
            "Like 'u' in 'hurt', with round lips",
            "neus (nose), deur (door)"
          ],
          [
            "g / ch",
            "Throaty, like a soft cough",
            "goed (good), acht (eight)"
          ],
          [
            "aa, ee, oo, uu",
            "Long vowels: hold them longer",
            "maan (moon), nee (no), boot (boat), uur (hour)"
          ]
        ]
      },
      "examples": [
        {
          "nl": "Goed, dank je.",
          "en": "Good, thanks."
        },
        {
          "nl": "Welterusten!",
          "en": "Good night!"
        },
        {
          "nl": "Goedenavond!",
          "en": "Good evening!"
        }
      ],
      "tip": "The Dutch **g** is not like English **g**. It comes from the throat: **goed** sounds a bit like 'khood' to English ears."
    },
    {
      "title": "Informal and formal greetings",
      "explanation": "Dutch has informal and more formal greetings. Use **hoi** and **doei** with friends, family and neighbours you know well. Use **goedemorgen**, **goedemiddag** and **goedenavond** in most other situations: at work, in shops, to strangers. **Tot ziens** is a little more formal than **doei**.",
      "table": {
        "headers": [
          "Informal",
          "Neutral / more formal",
          "When"
        ],
        "rows": [
          [
            "hoi",
            "goedemorgen / hallo",
            "when you meet"
          ],
          [
            "doei",
            "tot ziens",
            "when you leave"
          ],
          [
            "dank je",
            "dank u wel",
            "when you thank someone"
          ]
        ]
      },
      "examples": [
        {
          "nl": "Hoi! Hoe gaat het?",
          "en": "Hi! How are you?"
        },
        {
          "nl": "Goedemorgen! Hoe gaat het?",
          "en": "Good morning! How are you?"
        },
        {
          "nl": "Doei! Tot morgen!",
          "en": "Bye! See you tomorrow!"
        }
      ],
      "tip": "Common mistake: **welterusten** is not 'goodbye in the evening'. Use it only when someone goes to bed."
    }
  ],
